<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/ttl" android:text="November 2026"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/w_fg"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/pv"
            style="@style/WBtn"
            android:text="‹" />
        <TextView
            android:id="@+id/nx"
            style="@style/WBtn"
            android:text="›" />
        <TextView
            android:id="@+id/f"
            style="@style/WBtn"
            android:background="@drawable/widget_btn"
            android:textColor="@color/w_btn_fg"
            android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">
        <TextView style="@style/WDay" android:text="M" />
        <TextView style="@style/WDay" android:text="S" />
        <TextView style="@style/WDay" android:text="S" />
        <TextView style="@style/WDay" android:text="R" />
        <TextView style="@style/WDay" android:text="K" />
        <TextView style="@style/WDay" android:text="J" />
        <TextView style="@style/WDay" android:text="S" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/c0" android:text="1" style="@style/WCell" />
        <TextView android:id="@+id/c1" android:text="2" android:background="@drawable/cell_saved" style="@style/WCell" />
        <TextView android:id="@+id/c2" android:text="3" android:background="@drawable/cell_saved" style="@style/WCell" />
        <TextView android:id="@+id/c3" android:text="4" android:background="@drawable/cell_saved" style="@style/WCell" />
        <TextView android:id="@+id/c4" android:text="5" android:background="@drawable/cell_missed" style="@style/WCell" />
        <TextView android:id="@+id/c5" android:text="6" android:background="@drawable/cell_saved" style="@style/WCell" />
        <TextView android:id="@+id/c6" android:text="7" android:background="@drawable/cell_missed" style="@style/WCell" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/c7" android:text="8" android:background="@drawable/cell_missed" style="@style/WCell" />
        <TextView android:id="@+id/c8" android:text="9" android:background="@drawable/cell_saved" style="@style/WCell" />
        <TextView android:id="@+id/c9" android:text="10" android:background="@drawable/cell_saved" style="@style/WCell" />
        <TextView android:id="@+id/c10" android:text="11" android:background="@drawable/cell_saved" style="@style/WCell" />
        <TextView android:id="@+id/c11" android:text="12" android:background="@drawable/cell_saved" style="@style/WCell" />
        <TextView android:id="@+id/c12" android:text="13" style="@style/WCell" />
        <TextView android:id="@+id/c13" android:text="14" android:background="@drawable/cell_today_saved" style="@style/WCell" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/c14" android:text="15" style="@style/WCell" />
        <TextView android:id="@+id/c15" android:text="16" style="@style/WCell" />
        <TextView android:id="@+id/c16" android:text="17" style="@style/WCell" />
        <TextView android:id="@+id/c17" android:text="18" style="@style/WCell" />
        <TextView android:id="@+id/c18" android:text="19" style="@style/WCell" />
        <TextView android:id="@+id/c19" android:text="20" style="@style/WCell" />
        <TextView android:id="@+id/c20" android:text="21" style="@style/WCell" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/c21" android:text="22" style="@style/WCell" />
        <TextView android:id="@+id/c22" android:text="23" style="@style/WCell" />
        <TextView android:id="@+id/c23" android:text="24" style="@style/WCell" />
        <TextView android:id="@+id/c24" android:text="25" style="@style/WCell" />
        <TextView android:id="@+id/c25" android:text="26" style="@style/WCell" />
        <TextView android:id="@+id/c26" android:text="27" style="@style/WCell" />
        <TextView android:id="@+id/c27" android:text="28" style="@style/WCell" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/c28" android:text="29" style="@style/WCell" />
        <TextView android:id="@+id/c29" android:text="30" android:background="@drawable/cell_goal" style="@style/WCell" />
        <TextView android:id="@+id/c30" style="@style/WCell" />
        <TextView android:id="@+id/c31" style="@style/WCell" />
        <TextView android:id="@+id/c32" style="@style/WCell" />
        <TextView android:id="@+id/c33" style="@style/WCell" />
        <TextView android:id="@+id/c34" style="@style/WCell" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row6" android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/c35" style="@style/WCell" />
        <TextView android:id="@+id/c36" style="@style/WCell" />
        <TextView android:id="@+id/c37" style="@style/WCell" />
        <TextView android:id="@+id/c38" style="@style/WCell" />
        <TextView android:id="@+id/c39" style="@style/WCell" />
        <TextView android:id="@+id/c40" style="@style/WCell" />
        <TextView android:id="@+id/c41" style="@style/WCell" />
    </LinearLayout>

    <TextView
        android:id="@+id/ft" android:text="Liburan Bali · bulan ini Rp 1.200.000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/w_mut"
        android:textSize="11sp" />
</LinearLayout>
